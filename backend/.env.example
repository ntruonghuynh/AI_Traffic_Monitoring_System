DATABASE_URL="postgresql://traffic_app:change_me@127.0.0.1:5433/traffic_monitoring?schema=public"
PORT=3000
NODE_ENV=development
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE=104857600
CORS_ORIGIN=http://localhost:3001
INTERNAL_API_TOKEN=replace-with-a-long-random-development-token
# Chỉ dùng cho npm run test:integration; phải là database tách biệt.
TEST_DATABASE_URL="postgresql://traffic_app:change_me@127.0.0.1:5433/traffic_monitoring_test?schema=public"

# Worker cần PostgreSQL đã migrate cùng AI service Python đã cài editable.
# Đặt hai đường dẫn dưới đây thành đường dẫn tuyệt đối trên máy của bạn.
AI_PYTHON_BIN="/absolute/path/to/.venv/bin/python"
AI_SERVICE_ROOT="/absolute/path/to/ai-service"
# Bắt buộc: số nguyên dương, không có giới hạn tối đa trong code.
# Ví dụ 180000 ms; điều chỉnh theo thời lượng video và tốc độ máy.
AI_JOB_TIMEOUT_MS=180000
AI_WORKER_POLL_INTERVAL_MS=1000
# Tùy chọn: mặc định 1; số nguyên dương, không có giới hạn tối đa trong code.
AI_WORKER_CONCURRENCY=1
# Tùy chọn: chỉ nhận true/false; mặc định false.
AI_KEEP_FAILED_WORKDIR=false
# Tùy chọn: nếu đặt, phải là đường dẫn tuyệt đối tới file YAML đọc được.
# Nếu đặt AI_CONFIG_PATH, đường dẫn model tương đối được tính từ thư mục cha thứ hai của file config.
# AI_CONFIG_PATH="/absolute/path/to/ai-service/configs/default.yaml"
# Các model weights mặc định nằm trong ai-service/models/. Không commit file weights.
# Có thể override; nên dùng đường dẫn tuyệt đối.
# TRAFFIC_AI_VEHICLE_MODEL_PATH="/absolute/path/to/yolov8m.pt"
# TRAFFIC_AI_PLATE_MODEL_PATH="/absolute/path/to/license_plate_detector.pt"
# Python tùy chọn nhận auto, cpu, cuda hoặc mps.
# TRAFFIC_AI_DEVICE=auto
