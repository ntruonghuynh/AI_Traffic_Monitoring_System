DATABASE_URL="postgresql://traffic_app:change_me@127.0.0.1:5433/traffic_monitoring?schema=public"
PORT=3000
NODE_ENV=development
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE=104857600
CORS_ORIGIN=http://localhost:3001
INTERNAL_API_TOKEN=replace-with-a-long-random-development-token
# Chỉ dùng cho npm run test:integration; phải là database tách biệt.
TEST_DATABASE_URL="postgresql://traffic_app:change_me@127.0.0.1:5433/traffic_monitoring_test?schema=public"

# Chỉ cần cho tiến trình worker (npm run build && npm run worker)
AI_PYTHON_BIN="/absolute/path/to/.venv/bin/python"
AI_SERVICE_ROOT="/absolute/path/to/ai-service"
# AI_CONFIG_PATH="/absolute/path/to/ai-service/configs/default.yaml"
AI_JOB_TIMEOUT_MS=1800000
AI_WORKER_POLL_INTERVAL_MS=1000
AI_WORKER_CONCURRENCY=1
AI_KEEP_FAILED_WORKDIR=false
